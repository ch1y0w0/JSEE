[
  {
    "id": 1,
    "name": "fetch_calls",
    "regex": "fetch\\s*\\(\\s*[\"'`]((?:https?:\\/\\/[^\"'`]+)?\\/[a-zA-Z0-9._~:/?#\\[\\]@!$&()*+,;=%-]*)[\"'`]",
    "category": "http_client",
    "description": "fetch() API endpoints"
  },
  {
    "id": 2,
    "name": "axios_calls",
    "regex": "axios\\s*\\.\\s*(?:get|post|put|delete|patch|head|options)\\s*\\(\\s*[\"'`]((?:https?:\\/\\/[^\"'`]+)?\\/[a-zA-Z0-9._~:/?#\\[\\]@!$&()*+,;=%-]*)[\"'`]",
    "category": "http_client",
